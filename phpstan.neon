includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # Nivel de análisis (0-9). Nivel 5 es el recomendado por defecto en Larastan.
    level: 5

    excludePaths:
        - app/Http/Middleware/TrustProxies.php
